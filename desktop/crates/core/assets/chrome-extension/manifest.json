{
  "manifest_version": 3,
  "name": "Flow2API 浏览器直连",
  "version": "0.4.1",
  "description": "将 Google Flow 与 Flow Music 标签页直连到本机 Flow2API 桌面应用，Cookie 与令牌始终留在浏览器。",
  "permissions": [
    "storage",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://flow.google.com/*",
    "https://www.flowmusic.app/*",
    "https://flowmusic.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://www.flowmusic.app/*",
        "https://flowmusic.app/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://www.flowmusic.app/*",
        "https://flowmusic.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
